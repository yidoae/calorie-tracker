# Path is relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# FitBot: local LLM served by Ollama (https://ollama.com). Both are optional.
LOCAL_LLM_URL="http://localhost:11434"
LOCAL_LLM_MODEL="llama3.2"
# Context window in tokens (Ollama's default is small and truncates silently)
LOCAL_LLM_NUM_CTX="8192"
# How long Ollama keeps models loaded after a request (its default 5m means a ~6 s reload after a pause)
LOCAL_LLM_KEEP_ALIVE="30m"

# FitBot knowledge base (npm run kb:ingest). Embedding model must be pulled: ollama pull bge-m3
LOCAL_EMBED_MODEL="bge-m3"
# Embeddings run on the CPU so they don't evict the chat model from a small GPU; 1 = use the GPU
LOCAL_EMBED_GPU="0"
KB_TOP_K="4"
KB_MIN_SCORE="0.55"
KB_SCORE_MARGIN="0.1"

# Optional: Ollama vision model that reads nutrition labels (e.g. ollama pull qwen2.5vl:7b).
# Unset: labels are read with OCR (Tesseract, language data downloaded once into .cache/).
# LOCAL_VISION_MODEL="qwen2.5vl:7b"
