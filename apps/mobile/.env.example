# Supabase dev project (Settings → API). Only the URL and the publishable key ship in the app.
EXPO_PUBLIC_SUPABASE_URL="https://<dev-ref>.supabase.co"
EXPO_PUBLIC_SUPABASE_KEY="sb_publishable_..."

# Google sign-in (T026), from the owner's Google Cloud OAuth clients (supabase/README.md). Leave
# empty until they exist: the "Google ile devam et" button is hidden while the web client ID is
# empty (on iOS also while the iOS client ID is empty).
# Web client ID: also entered in the Supabase Google provider; the ID token's audience on Android.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
# iOS client ID ("<id>.apps.googleusercontent.com"); app.config.ts derives the iOS URL scheme
# from it and only then adds the google-signin config plugin.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
