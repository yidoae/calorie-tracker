{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "apps/mobile": {
      "entry": [
        "src/app/**/*.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "expo-updates"
      ]
    },
    "packages/core": {
      "entry": [
        "src/**/*.ts",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "tests/**/*.ts"
      ]
    },
    "tools/preview": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "expo-updates"
      ]
    }
  }
}
