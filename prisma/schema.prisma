generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  /// Stored lower-cased; unique per account.
  username     String    @unique
  /// argon2id hash (salt + parameters embedded). The plain password is never stored.
  passwordHash String
  /// JSON: saved profiles, active profile id and custom plan (see src/lib/settings.ts).
  settings     String?
  /// False until the first-time setup (/baslangic) is done; the panel pages redirect there until then.
  onboardingCompleted Boolean @default(false)
  createdAt    DateTime  @default(now())
  meals        Meal[]
  sessions     Session[]
  weights      WeightLog[]
  water        WaterLog[]
  savedMeals   SavedMeal[]
  customFoods  CustomFood[]
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the cookie token, so a leaked DB can't be replayed as live sessions.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Meal {
  id        String   @id @default(cuid())
  name      String
  calories  Int
  protein   Float
  carbs     Float
  fat       Float
  imageUrl  String?
  /// breakfast | lunch | dinner | snack (validated by mealSlotSchema)
  slot      String   @default("snack")
  createdAt DateTime @default(now())
  /// Null only for meals logged before accounts existed; those are never shown.
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Plate components (photo breakdown or quick-bar items). Totals above are their sum.
  items     MealItem[]

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// One component of a meal. Nutrition is stored per 100 g so the portion stays editable.
model MealItem {
  id            String @id @default(cuid())
  mealId        String
  meal          Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  position      Int
  name          String
  /// protein | carb | fat | vegetable | fruit | dairy (validated by foodCategorySchema)
  category      String
  grams         Float
  kcalPer100    Float
  proteinPer100 Float
  carbsPer100   Float
  fatPer100     Float
  /// Optional micronutrients per 100 g (null = unknown for this food).
  fiberPer100   Float?
  sugarPer100   Float?
  satFatPer100  Float?
  /// mg per 100 g
  sodiumPer100  Float?

  @@index([mealId])
}

/// One body-weight entry per user and local day (re-logging a day replaces it).
model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Local calendar day, YYYY-MM-DD.
  day       String
  kg        Float
  createdAt DateTime @default(now())

  @@unique([userId, day])
}

/// One drink entry (ml); a day's total is the sum of its entries.
model WaterLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ml        Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// A reusable meal template ("Kayıtlı öğün"): name, slot and items, logged again in one tap.
model SavedMeal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  slot      String
  /// JSON array of meal items (validated by mealItemSchema on read).
  items     String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Cached Open Food Facts lookups by barcode (shared; product data is public).
model FoodProduct {
  barcode   String   @id
  /// JSON of the normalised product, or null when OFF doesn't know the barcode.
  data      String?
  fetchedAt DateTime @default(now())
}

/// A food the user entered themselves (typed or read from a pack's nutrition label); shown in
/// "Hızlı ekle" next to the built-in foods. Nutrition per 100 g like MealItem.
model CustomFood {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  brand         String?
  kcalPer100    Float
  proteinPer100 Float
  carbsPer100   Float
  fatPer100     Float
  fiberPer100   Float?
  sugarPer100   Float?
  satFatPer100  Float?
  /// mg per 100 g
  sodiumPer100  Float?
  /// Grams in one serving as printed on the pack, if known (shown as a hint, never pre-filled).
  servingGrams  Float?
  createdAt     DateTime @default(now())

  @@index([userId])
}
